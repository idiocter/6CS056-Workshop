#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

usage() {
    printf '%s\n' "Usage: ./laravel-create PROJECT-NAME [--blade|--vite|--react|--vue|--svelte|--livewire]"
}

project_name="${1:-}"
stack="${2:-}"

if [ -z "$project_name" ]; then
    usage
    exit 1
fi

case "$project_name" in
    *[!A-Za-z0-9_-]*|'')
        printf '%s\n' "Project names may contain only letters, numbers, hyphens, and underscores."
        exit 1
        ;;
esac

if [ -e "$project_name" ]; then
    printf '%s\n' "The destination already exists: $project_name"
    exit 1
fi

if [ -z "$stack" ]; then
    printf '%s\n' \
        "Choose a Laravel frontend:" \
        "  1) Blade only" \
        "  2) Vite" \
        "  3) React with Vite" \
        "  4) Vue with Vite" \
        "  5) Svelte with Vite" \
        "  6) Livewire"
    printf 'Selection [1]: '
    read -r selection

    case "${selection:-1}" in
        1) stack="--blade" ;;
        2) stack="--vite" ;;
        3) stack="--react" ;;
        4) stack="--vue" ;;
        5) stack="--svelte" ;;
        6) stack="--livewire" ;;
        *)
            printf '%s\n' "Invalid selection."
            exit 1
            ;;
    esac
fi

case "$stack" in
    --blade|blade)
        package="laravel/laravel"
        stability="stable"
        frontend_mode="blade"
        ;;
    --vite|vite)
        package="laravel/laravel"
        stability="stable"
        frontend_mode="vite"
        ;;
    --react|react)
        package="laravel/react-starter-kit"
        stability="dev"
        frontend_mode="react"
        ;;
    --vue|vue)
        package="laravel/vue-starter-kit"
        stability="dev"
        frontend_mode="vue"
        ;;
    --svelte|svelte)
        package="laravel/svelte-starter-kit"
        stability="dev"
        frontend_mode="svelte"
        ;;
    --livewire|livewire)
        package="laravel/livewire-starter-kit"
        stability="dev"
        frontend_mode="livewire"
        ;;
    *)
        usage
        exit 1
        ;;
esac

template_dir="$script_dir/.laravel-docker"

if [ ! -f "$template_dir/Dockerfile" ] || [ ! -f "$template_dir/compose.yaml" ] || [ ! -f "$template_dir/dockerignore" ] || [ ! -f "$template_dir/entrypoint.sh" ]; then
    printf '%s\n' "Docker templates are missing from $template_dir"
    exit 1
fi

printf '%s\n' "Creating $project_name from $package using Docker..."

if [ "$stability" = "dev" ]; then
    docker run --rm -it \
        -u "$(id -u):$(id -g)" \
        -v "$PWD:/workspace" \
        -w /workspace \
        composer:2 \
        create-project "$package" "$project_name" --stability=dev
else
    docker run --rm -it \
        -u "$(id -u):$(id -g)" \
        -v "$PWD:/workspace" \
        -w /workspace \
        composer:2 \
        create-project "$package" "$project_name"
fi

cp "$template_dir/Dockerfile" "$project_name/Dockerfile"
cp "$template_dir/compose.yaml" "$project_name/compose.yaml"
cp "$template_dir/dockerignore" "$project_name/.dockerignore"
mkdir -p "$project_name/docker"
cp "$template_dir/entrypoint.sh" "$project_name/docker/entrypoint.sh"
chmod +x "$project_name/docker/entrypoint.sh"
printf '%s\n' "$frontend_mode" > "$project_name/.laravel-frontend"

printf '\nCreated %s/%s\n' "$PWD" "$project_name"
printf 'Frontend mode: %s\n' "$frontend_mode"
printf 'Start it: cd %s && docker compose up -d --build\n' "$project_name"
